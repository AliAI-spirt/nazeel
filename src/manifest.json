{
  "manifest_version": 3,
  "name": "Nazeel | نزيل",
  "short_name": "Nazeel",
  "version": "5.2.0",
  "version_name": "5.2.0",
  "minimum_chrome_version": "114",
  "description": "إحصائيات نزلاء الفندق + مساعد إدخال ذكي يقرأ الهوية والجواز والتأشيرة ويعبّي الاستمارة للمراجعة.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "http://localhost:11434/*",
    "http://127.0.0.1:11434/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "نزيل — إحصائيات النزلاء",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "assistant.html"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ollama_origin",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'none'"
  }
}
